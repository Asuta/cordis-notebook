{
  "parameters": {
    "pluginId": { "description": "已在独立空实例启用的插件 ID", "pattern": "^[a-z][a-z0-9-]{1,49}$" },
    "actionLabel": { "description": "更多笔记操作菜单中的可访问名称" },
    "formatName": { "default": "普通笔记", "description": "插件支持的格式，在新建菜单中的名称；默认普通笔记" }
  },
  "coverage": ["无选择时唯一入口且禁用", "创建后可用", "切换笔记后可用", "停用移除入口", "重新启用唯一入口", "刷新后恢复"],
  "steps": [
    { "action": "click", "target": { "role": "button", "name": "更多笔记操作" } },
    { "action": "assert", "target": { "role": "menuitem", "name": "{{actionLabel}}" }, "assertion": "disabled", "expected": true, "label": "无选择时入口唯一且禁用" },
    { "action": "press", "target": { "role": "menu" }, "value": "Escape" },
    { "action": "click", "target": { "role": "button", "name": "新建笔记" } },
    { "action": "click", "target": { "role": "menuitem", "name": "{{formatName}}" } },
    { "action": "assert", "target": { "role": "textbox", "name": "笔记标题" }, "assertion": "value", "expected": "", "label": "第一篇已选中" },
    { "action": "fill", "target": { "role": "textbox", "name": "笔记标题" }, "value": "{{firstTitle}}" },
    { "action": "assert", "target": { "css": ".save-status" }, "expected": "已保存到本地", "label": "第一篇标题已保存" },
    { "action": "click", "target": { "role": "button", "name": "更多笔记操作" } },
    { "action": "assert", "target": { "role": "menuitem", "name": "{{actionLabel}}" }, "assertion": "disabled", "expected": false, "label": "创建后入口唯一且可用" },
    { "action": "press", "target": { "role": "menu" }, "value": "Escape" },
    { "action": "click", "target": { "role": "button", "name": "新建笔记" } },
    { "action": "click", "target": { "role": "menuitem", "name": "{{formatName}}" } },
    { "action": "assert", "target": { "role": "textbox", "name": "笔记标题" }, "assertion": "value", "expected": "", "label": "第二篇已选中" },
    { "action": "fill", "target": { "role": "textbox", "name": "笔记标题" }, "value": "{{secondTitle}}" },
    { "action": "assert", "target": { "css": ".save-status" }, "expected": "已保存到本地", "label": "第二篇标题已保存" },
    { "action": "click", "target": { "text": "{{firstTitle}}" } },
    { "action": "assert", "target": { "role": "textbox", "name": "笔记标题" }, "assertion": "value", "expected": "{{firstTitle}}", "label": "切回第一篇完成" },
    { "action": "click", "target": { "role": "button", "name": "更多笔记操作" } },
    { "action": "assert", "target": { "role": "menuitem", "name": "{{actionLabel}}" }, "assertion": "disabled", "expected": false, "label": "切换笔记后仍可用" },
    { "action": "press", "target": { "role": "menu" }, "value": "Escape" },
    { "action": "click", "target": { "css": "#manage-plugins" } },
    { "action": "click", "target": { "testId": "plugin-select-{{pluginId}}" } },
    { "action": "click", "target": { "testId": "plugin-toggle-{{pluginId}}" } },
    { "action": "assert", "target": { "testId": "plugin-toggle-{{pluginId}}" }, "expected": "启用插件", "label": "停用完成" },
    { "action": "click", "target": { "role": "button", "name": "关闭插件管理" } },
    { "action": "click", "target": { "role": "button", "name": "更多笔记操作" } },
    { "action": "assert", "target": { "role": "menuitem", "name": "{{actionLabel}}" }, "assertion": "visible", "expected": false, "label": "停用后入口移除" },
    { "action": "press", "target": { "role": "menu" }, "value": "Escape" },
    { "action": "click", "target": { "css": "#manage-plugins" } },
    { "action": "click", "target": { "testId": "plugin-select-{{pluginId}}" } },
    { "action": "click", "target": { "testId": "plugin-toggle-{{pluginId}}" } },
    { "action": "assert", "target": { "testId": "plugin-toggle-{{pluginId}}" }, "expected": "停用插件", "label": "重新启用完成" },
    { "action": "click", "target": { "role": "button", "name": "关闭插件管理" } },
    { "action": "click", "target": { "role": "button", "name": "更多笔记操作" } },
    { "action": "assert", "target": { "role": "menuitem", "name": "{{actionLabel}}" }, "assertion": "disabled", "expected": false, "label": "重新启用只有一个可用入口" },
    { "action": "press", "target": { "role": "menu" }, "value": "Escape" },
    { "action": "reload" },
    { "action": "assert", "target": { "role": "textbox", "name": "笔记标题" }, "assertion": "value", "expected": "{{firstTitle}}", "label": "刷新后当前笔记恢复" },
    { "action": "click", "target": { "role": "button", "name": "更多笔记操作" } },
    { "action": "assert", "target": { "role": "menuitem", "name": "{{actionLabel}}" }, "assertion": "disabled", "expected": false, "label": "刷新后入口唯一且可用" },
    { "action": "press", "target": { "role": "menu" }, "value": "Escape" },
    { "action": "screenshot" },
    { "action": "snapshot" }
  ]
}
