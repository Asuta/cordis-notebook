{
  "name": "@cordis-notebook/database-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "cordis": {
    "schemaVersion": 1,
    "id": "database-editor",
    "name": "数据库与命名视图",
    "description": "自定义属性、命名视图和可嵌入的表格/看板。",
    "requires": {
      "server": [],
      "client": [
        "ui",
        "notebook",
        "editorHost",
        "noteFormats",
        "shell",
        "databaseSchema"
      ]
    },
    "provides": {
      "server": [],
      "client": [
        "databaseUI"
      ]
    },
    "order": 20,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js",
      "style.css"
    ],
    "styles": [
      "style.css"
    ],
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "Table",
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "minify": true,
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        }
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      }
    ],
    "capabilities": [
      {
        "service": "databaseUI",
        "side": "client",
        "description": "独立页面与 BlockNote 共享的数据库视图组件",
        "contracts": [
          "types/client.d.ts"
        ],
        "examples": [
          "view.jsx"
        ],
        "lifecycle": [
          "通过公开服务访问；写入仍经过 notebook 的保存保护和 revision 校验。"
        ]
      }
    ]
  }
}
