{
  "name": "@cordis-notebook/note-formats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "cordis": "4.0.0-rc.10",
    "@cordis-notebook/host": "workspace:*",
    "@cordis-notebook/notes": "workspace:*"
  },
  "cordis": {
    "capabilities": [
      { "service": "noteFormats", "side": "client", "description": "页面笔记格式注册、正文提取和只读快照", "contracts": ["types/client.d.ts", "types/data.d.ts"], "examples": ["client.js"], "lifecycle": ["register(owner, definition) 随 owner 释放；派生 content 与原始格式字段需要区分。"] },
      { "service": "noteFormats", "side": "server", "description": "服务端独立校验笔记格式与派生正文", "contracts": ["types/server.d.ts", "types/data.d.ts"], "examples": ["server.js"], "lifecycle": ["前后端分别注册格式，不能假定另一端已有相同提供者。"] }
    ],
    "schemaVersion": 1,
    "id": "note-formats",
    "name": "笔记格式注册服务",
    "description": "管理格式声明、校验与文本提取。",
    "requires": {
      "server": [],
      "client": []
    },
    "provides": {
      "server": [
        "noteFormats"
      ],
      "client": [
        "noteFormats"
      ]
    },
    "order": 6,
    "defaultEnabled": true,
    "client": "client.js",
    "server": {
      "entry": "server.js",
      "export": "noteFormats"
    },
    "public": [
      "client.js"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "category": {
      "id": "services",
      "label": "基础能力"
    },
    "icon": "Blocks",
    "styles": []
  },
  "exports": {
    "./data": {
      "types": "./types/data.d.ts"
    },
    "./client": {
      "types": "./types/client.d.ts"
    },
    "./server": {
      "types": "./types/server.d.ts"
    }
  }
}
