{
  "name": "@cordis-notebook/format-blocknote", "version": "1.0.0", "private": true, "type": "module",
  "dependencies": { "cordis": "4.0.0-rc.10" },
  "cordis": {
    "schemaVersion": 1, "id": "format-blocknote", "name": "BlockNote 页面格式", "description": "保存 BlockNote 原生块数据，支持富文本、嵌套、表格与媒体。",
