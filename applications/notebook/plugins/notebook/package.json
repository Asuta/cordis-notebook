{
  "name": "@cordis-notebook/notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cordis-notebook/host": "workspace:*",
    "cordis": "4.0.0-rc.10",
    "@cordis-notebook/notes": "workspace:*"
  },
  "cordis": {
    "capabilities": [{ "service": "notebook", "side": "client", "description": "当前页面的笔记、草稿、保存与筛选服务", "contracts": ["types/client.d.ts"], "examples": ["client.js"], "lifecycle": ["observe(owner, handler) 的订阅随 owner 释放；current() 返回只读快照。", "先 flush 再切换或停止；版本冲突保留草稿并由用户另存副本。"] }],
    "schemaVersion": 1,
    "id": "notebook",
    "name": "前端笔记服务",
    "description": "共享选择、草稿、自动保存与恢复。",
    "requires": {
      "server": [],
      "client": [
        "notesApi",
        "shell",
        "noteFormats"
      ]
    },
    "provides": {
      "server": [],
      "client": [
        "notebook"
      ]
    },
    "settings": {
      "mode": "restart",
      "fields": {
        "autosaveMs": {
          "type": "number",
          "label": "自动保存间隔（毫秒）",
          "description": "停止输入后等待多久保存。保存设置会先保存草稿，再重新加载笔记服务及其界面。",
          "default": 600,
          "min": 100,
          "max": 10000,
          "step": 100,
          "integer": true
        }
      }
    },
    "order": 14,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js",
      "style.css"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      }
    ],
    "category": {
      "id": "services",
      "label": "基础能力"
    },
    "icon": "Blocks",
    "styles": [
      "style.css"
    ]
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts"
    }
  }
}
