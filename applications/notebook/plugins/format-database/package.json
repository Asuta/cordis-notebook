{
  "name": "@cordis-notebook/format-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "cordis": {
    "schemaVersion": 1,
    "id": "format-database",
    "name": "数据库页面格式",
    "description": "数据库页面格式",
    "requires": {
      "server": [
        "noteFormats"
      ],
      "client": [
        "noteFormats"
      ]
    },
    "provides": {
      "server": [],
      "client": [
        "databaseSchema"
      ]
    },
    "order": 10,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js"
    ],
    "styles": [],
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "Table",
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "minify": true
      },
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "server": {
      "entry": "server.js",
      "export": "default"
    },
    "capabilities": [
      {
        "service": "databaseSchema",
        "side": "client",
        "description": "数据库字段、命名视图、筛选排序和记录值的纯数据契约",
        "contracts": [
          "types/client.d.ts"
        ],
        "examples": [
          "schema.js"
        ],
        "lifecycle": [
          "通过公开服务访问；写入仍经过 notebook 的保存保护和 revision 校验。"
        ]
      }
    ]
  }
}
