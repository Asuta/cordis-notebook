{
  "name": "@cordis-notebook/notes-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cordis-notebook/host": "workspace:*",
    "cordis": "4.0.0-rc.10",
    "@cordis-notebook/notes": "workspace:*"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "notes-api",
    "name": "笔记 API",
    "description": "通过 HTTP 提供笔记服务，并向页面提供 notesApi 服务。",
    "requires": {
      "server": [
        "notes",
        "http"
      ],
      "client": []
    },
    "provides": {
      "server": [],
      "client": [
        "notesApi"
      ]
    },
    "order": 12,
    "defaultEnabled": true,
    "client": "client.js",
    "server": {
      "entry": "server.js",
      "export": "api"
    },
    "public": [
      "client.js"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "category": {
      "id": "services",
      "label": "基础能力"
    },
    "icon": "Blocks",
    "styles": []
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts"
    }
  }
}
