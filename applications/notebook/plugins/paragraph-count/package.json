        "shell"
      ]
    },
    "provides": {
      "server": [],
      "client": []
    },
    "public": [
      "client.js",
      "style.css"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser"
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      }
    ],
    "client": "client.js",
    "styles": [
      "style.css"
    ],
    "order": 26,
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "AlignLeft"
  }
