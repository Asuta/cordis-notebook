{
  "name": "@cordis-notebook/paragraph-count",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {},
  "cordis": {
    "schemaVersion": 1,
    "id": "paragraph-count",
    "name": "段落计数",
    "description": "在编辑区底栏显示当前笔记的非空段落数（按空行分段），支持普通笔记与 Markdown。",
    "requires": {
      "server": [],
      "client": [
        "notebook",
        "shell"
      ]
    },
    "provides": {
      "server": [],
      "client": []
    },
    "order": 33,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js",
      "style.css"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "minify": true
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      }
    ],
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "List",
    "styles": [
      "style.css"
    ]
  }
}
