{
  "name": "@cordis-notebook/paragraph-count",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {},
  "cordis": {
    "schemaVersion": 1,
    "id": "paragraph-count",
    "name": "段落计数",
