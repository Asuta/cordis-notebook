{
  "name": "@cordis-notebook/notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "cordis": "4.0.0-rc.10",
    "@cordis-notebook/host": "workspace:*"
  },
  "cordis": {
    "capabilities": [{ "service": "notes", "side": "server", "description": "持久化笔记的增删改查与版本校验", "contracts": ["types/server.d.ts", "types/data.d.ts"], "examples": ["server.js"], "lifecycle": ["外部写请求必须传 expectedRevision；不要绕过此服务直接覆盖笔记文件。"] }],
    "schemaVersion": 1,
    "id": "notes",
    "name": "笔记业务",
    "description": "笔记增删改查与数据校验。",
    "requires": {
      "server": [
        "storage",
        "noteFormats"
      ],
      "client": []
    },
    "provides": {
      "server": [
        "notes"
      ],
      "client": []
    },
    "order": 11,
    "defaultEnabled": true,
    "server": {
      "entry": "server.js",
      "export": "notes"
    },
    "public": [],
    "build": [
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "category": {
      "id": "services",
      "label": "基础能力"
    },
    "icon": "Blocks",
    "styles": []
  },
  "exports": {
    "./data": {
      "types": "./types/data.d.ts"
    },
    "./server": {
      "types": "./types/server.d.ts"
    }
  }
}
