{
  "name": "@cordis-studio/canvas-basic-cards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "canvas-basic-cards",
    "name": "文字与图片卡片",
    "description": "文字与图片卡片",
    "defaultEnabled": true,
    "order": 10,
    "requires": {
      "server": [
        "http",
        "canvasDocuments"
      ],
      "client": [
        "canvasUI",
        "canvasSession"
      ]
    },
    "provides": {
      "server": [
        "canvasBasicCards"
      ],
      "client": []
    },
    "build": [
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      },
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser"
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      },
      {
        "type": "copy",
        "input": "library.css",
        "output": "library.css"
      }
    ],
    "server": {
      "entry": "server.js",
      "export": "default"
    },
    "client": "client.js",
    "public": [
      "client.js",
      "style.css",
      "library.css"
    ],
    "styles": [
      "style.css",
      "library.css"
    ]
  }
}
