{
  "name": "@cordis-studio/canvas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "cordis": "4.0.0-rc.10",
    "sharp": "^0.35.5",
    "@cordis-notebook/host": "workspace:*"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "canvas",
    "name": "画布基础",
    "description": "画布基础",
    "defaultEnabled": true,
    "order": 0,
    "requires": {
      "server": [
        "http"
      ],
      "client": []
    },
    "provides": {
      "server": [
        "canvasDocuments"
      ],
      "client": [
        "canvasSession"
      ]
    },
    "build": [
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      },
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser"
      }
    ],
    "server": {
      "entry": "server.js",
      "export": "default"
    },
    "client": "client.js",
    "public": [
      "client.js"
    ]
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts"
    },
    "./data": {
      "types": "./types/data.d.ts"
    },
    "./server": {
      "types": "./types/server.d.ts"
    }
  }
}
