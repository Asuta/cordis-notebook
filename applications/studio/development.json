  "recipes": {
    "ui": {
      "presentation": {
        "styles": {
          "note": "canvasUI.menu 的按钮位于 .studio-app 内，继承现有按钮样式；有需要时用 className 添加插件专属 class。以下变量只在 .studio-app 内可用，不能给 body 独立面板直接使用。",
          "tokens": [
            "--ink",
            "--muted",
            "--accent",
            "--line"
          ]
        },
        "icons": {
          "note": "menu 没有 icon 参数，label 可用文字加符号，如 ＋ 动作；卡片视图 register 的 icon 是另一接口的文字标记。"
        },
        "ordering": {
          "note": "canvasUI.menu 支持 order，默认 1000；升序，同值按 id。现有文字动作 10、图片动作 20，新动作可用 30。",
          "example": "ctx.canvasUI.menu(ctx, {id:'<plugin-id>', label:'＋ 动作', order:30, run:() => sdk.toast('完成')})"
        },
        "references": [
          {
            "file": "plugins/canvas-ui/style.css",
            "start": 1,
            "end": 6
          },
          {
            "file": "plugins/canvas-ui/client.js",
            "start": 933,
            "end": 944
          }
        ]
      },
      "services": {
        "client": [
          "canvasUI",
          "canvasSession"
        ],
        "server": []
      },
      "contracts": [
        "plugins/canvas-ui/types/client.d.ts",
        "plugins/canvas/types/client.d.ts"
      ],
      "examples": [
        "development/studio-card/client.js.txt",
        "development/studio-card/card.js.txt",
        "development/studio-card/package.json.txt"
      ],
      "patterns": [
        "界面扩展通过 canvasUI.register/menu/extend，传 ctx 绑定生命周期；本应用没有 notebook/shell 页脚。",
        "画板读取和修改通过 canvasSession，修改保留 expectedRevision 和历史；视图订阅用 attachView(ctx, view)。"
      ]
    },
    "backend": {
      "services": {
        "client": [],
        "server": [
          "imageGeneration"
        ]
      },
      "contracts": [
        "development/studio-provider/README.md.txt"
      ],
      "examples": [
        "development/studio-provider/server.js.txt",
        "development/studio-provider/package.json.txt"
      ],
      "patterns": [
        "prepare 同步校验并冻结输入与私有配置；generate 响应 AbortSignal；本地样例只输出固定 PNG。"
      ]
    },
    "agent": {
      "services": {
        "client": [
          "canvasSession",
          "canvasUI"
        ],
        "server": []
      },
      "contracts": [
        "development/studio-agent-action/README.md.txt"
      ],
      "examples": [
        "development/studio-agent-action/client.js.txt",
        "development/studio-agent-action/action.js.txt",
        "development/studio-agent-action/package.json.txt",
        "development/shared/mutation.js.txt"
      ],
      "patterns": [
        "注册 canvasSession.actions.register(ctx, action)，schema 用于发现，run 仍需校验；写操作保留 revision 和异步保护。"
      ]
    }
  },
