{
  "name": "@cordis-notebook/theme-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "cordis": "4.0.0-rc.10",
    "@cordis-notebook/host": "workspace:*"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "theme-engine",
    "name": "主题引擎",
    "description": "提供主题应用与清理能力，资源归属具体主题插件。",
    "requires": {
      "server": [],
      "client": []
    },
    "provides": {
      "server": [
        "themeEngine"
      ],
      "client": [
        "themeEngine"
      ]
    },
    "order": 5,
    "defaultEnabled": true,
    "client": "client.js",
    "server": {
      "entry": "server.js",
      "export": "themeEngine"
    },
    "public": [
      "client.js"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "category": {
      "id": "services",
      "label": "基础能力"
    },
    "icon": "Blocks",
    "styles": []
  },
  "exports": {
    "./data": {
      "types": "./types/data.d.ts"
    },
    "./client": {
      "types": "./types/client.d.ts"
    },
    "./server": {
      "types": "./types/server.d.ts"
    }
  }
}
