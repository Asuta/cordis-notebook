{
  "name": "@cordis-notebook/layout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cordis-notebook/host": "workspace:*",
    "cordis": "4.0.0-rc.10",
    "tailwindcss": "^4.3.3",
    "@cordis-notebook/ui": "workspace:*"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "layout",
    "name": "留白布局",
    "description": "提供侧栏、编辑区、工具栏和扩展面板服务。",
    "requires": {
      "server": [],
      "client": [
        "ui"
      ]
    },
    "provides": {
      "server": [],
      "client": [
        "shell"
      ]
    },
    "order": 13,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js",
      "style.css",
      "utilities.css"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      },
      {
        "type": "tailwind",
        "input": "tailwind.css",
        "output": "utilities.css"
      }
    ],
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "Puzzle",
    "styles": [
      "style.css",
      "utilities.css"
    ]
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts"
    }
  }
}
