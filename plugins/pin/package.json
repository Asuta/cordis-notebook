{
  "name": "@cordis-notebook/pin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {},
  "cordis": {
    "schemaVersion": 1,
    "id": "pin",
    "name": "置顶",
    "description": "置顶笔记与筛选收藏。",
    "requires": {
      "server": [],
      "client": [
        "notebook",
        "noteListUI",
        "shell"
      ]
    },
    "provides": {
      "server": [],
      "client": []
    },
    "order": 21,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js",
      "style.css"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "copy",
        "input": "style.css",
        "output": "style.css"
      }
    ],
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "Puzzle",
    "styles": [
      "style.css"
    ]
  }
}
