{
  "name": "@cordis-notebook/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "lucide-react": "^1.48.0",
    "class-variance-authority": "^0.7.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "tailwindcss": "^4.3.3",
    "@cordis-notebook/host": "workspace:*",
    "cordis": "4.0.0-rc.10"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "ui",
    "name": "界面组件与渲染",
    "description": "统一 React、shadcn 组件与随插件清理的界面挂载。",
    "requires": {
      "server": [],
      "client": []
    },
    "provides": {
      "server": [],
      "client": [
        "ui"
      ]
    },
    "order": 2,
    "defaultEnabled": true,
    "client": "client.js",
    "public": [
      "client.js",
      "style.css"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "minify": true
      },
      {
        "type": "tailwind",
        "input": "tailwind.css",
        "output": "style.css"
      }
    ],
    "runtimePackages": [
      "react",
      "react-dom"
    ],
    "category": {
      "id": "services",
      "label": "基础能力"
    },
    "icon": "Blocks",
    "styles": [
      "style.css"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts"
    },
    "./theme.css": "./theme.css"
  }
}
