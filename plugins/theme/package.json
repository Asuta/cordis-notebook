{
  "name": "@cordis-notebook/theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cordis-notebook/host": "workspace:*",
    "cordis": "4.0.0-rc.10",
    "@cordis-notebook/theme-engine": "workspace:*"
  },
  "cordis": {
    "schemaVersion": 1,
    "id": "theme",
    "name": "苔绿主题",
    "description": "柔和的苔绿与温暖纸张，同组主题只能启用一个。",
    "requires": {
      "server": [
        "themeEngine"
      ],
      "client": [
        "shell",
        "themeEngine"
      ]
    },
    "provides": {
      "server": [
        "theme"
      ],
      "client": [
        "theme"
      ]
    },
    "exclusiveGroup": "appearance.theme",
    "groupLabel": "主题",
    "swatch": "#68845a",
    "order": 25,
    "defaultEnabled": true,
    "client": "client.js",
    "server": {
      "entry": "server.js",
      "export": "theme"
    },
    "public": [
      "client.js"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "category": {
      "id": "themes",
      "label": "外观"
    },
    "icon": "Palette",
    "styles": []
  },
  "exports": {
    "./client": {
      "types": "./types/client.d.ts"
    },
    "./server": {
      "types": "./types/server.d.ts"
    }
  }
}
