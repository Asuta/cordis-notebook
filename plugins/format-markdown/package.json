{
  "name": "@cordis-notebook/format-markdown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {},
  "cordis": {
    "schemaVersion": 1,
    "id": "format-markdown",
    "name": "Markdown 笔记格式",
    "description": "保存 Markdown 源码，提取正文供搜索与统计使用。",
    "requires": {
      "server": [
        "noteFormats",
        "markdown"
      ],
      "client": [
        "noteFormats",
        "markdown"
      ]
    },
    "provides": {
      "server": [],
      "client": []
    },
    "order": 9,
    "defaultEnabled": true,
    "client": "client.js",
    "server": {
      "entry": "server.js",
      "export": "formatMarkdown"
    },
    "public": [
      "client.js"
    ],
    "build": [
      {
        "type": "bundle",
        "input": "client.js",
        "output": "client.js",
        "platform": "browser",
        "jsx": {
          "factory": "h",
          "fragment": "Fragment"
        },
        "minify": true
      },
      {
        "type": "bundle",
        "input": "server.js",
        "output": "server.js",
        "platform": "node"
      }
    ],
    "category": {
      "id": "features",
      "label": "功能"
    },
    "icon": "Puzzle",
    "styles": []
  }
}
