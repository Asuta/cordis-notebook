{
  "name": "cordis-notebook",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm exec tailwindcss -i plugins/ui/tailwind.css -o plugins/ui/style.css --minify && node scripts/build.js",
    "dev": "pnpm build && node --watch server/server.js",
    "start": "pnpm build && node server/server.js",
    "typecheck": "tsc -p tsconfig.contracts.json",
    "test": "pnpm typecheck && pnpm build && node --test test/*.test.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cordis": "4.0.0-rc.10",
    "lucide-react": "^1.48.0",
    "markdown-it": "15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
