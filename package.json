{
  "name": "cordis-notebook",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:agent": "node scripts/agent-benchmark/run.js",
    "test:benchmark": "node scripts/test-agent-benchmark.js",
    "docs:inventory": "node scripts/plugin-inventory.js",
    "docs:capabilities": "node scripts/capability-index.js",
    "workbench": "node workbench/build.js && node --report-on-fatalerror --report-uncaught-exception --report-compact --report-exclude-env --report-exclude-network --report-directory=.workbench/diagnostics workbench/server.js",
    "workbench:production": "pnpm build && node --report-on-fatalerror --report-uncaught-exception --report-compact --report-exclude-env --report-exclude-network --report-directory=.workbench/diagnostics workbench/server.js --production",
    "workbench:runtime": "node --report-on-fatalerror --report-uncaught-exception --report-compact --report-exclude-env --report-exclude-network --report-directory=.workbench/diagnostics workbench/server.js --production",
    "build": "node scripts/build.js",
    "export:plugins": "node scripts/export-plugins.js",
    "export:app": "node scripts/export-application.js",
    "start:runtime": "node server/server.js",
    "dev": "node scripts/dev.js",
    "start": "pnpm build && node server/server.js",
    "typecheck": "tsc -p tsconfig.contracts.json && tsc -p tsconfig.runtime.json",
    "test:plugin": "node scripts/test-plugin.js",
    "browser:install": "playwright install chromium",
    "test:browser": "node scripts/test-browser.js",
    "test": "pnpm typecheck && pnpm build && node scripts/test-all.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@sinclair/typebox": "0.34.41",
    "@vscode/ripgrep": "^1.18.0",
    "cordis": "4.0.0-rc.10",
    "markdown-it": "15.0.2",
    "node-pty": "1.1.0",
    "playwright": "1.64.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cordis-notebook/host": "workspace:*",
    "@cordis-notebook/markdown": "workspace:*",
    "@cordis-notebook/note-assets": "workspace:*",
    "@cordis-notebook/note-formats": "workspace:*",
    "@cordis-notebook/notebook": "workspace:*",
    "@cordis-notebook/notes": "workspace:*",
    "@cordis-notebook/rich-text": "workspace:*",
    "@cordis-notebook/theme-engine": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
